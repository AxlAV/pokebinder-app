{
  "expo": {
    "name": "PokeBinder",
    "slug": "pokebinder-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pokebinder",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111015"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokebinder.app",
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111015",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pokebinder.app",
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "PokeBinder usa la cámara para leer el nombre y el número de tus cartas.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PokeBinder necesita acceso a tus fotos para leer cartas desde la galería.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withMlKitProguard"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
